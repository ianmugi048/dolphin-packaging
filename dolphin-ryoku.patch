+QPair<QColor, QColor> KFileItemListWidget::mimeCategoryColors() const
+{
+    const QHash<QByteArray, QVariant> values = data();
+
+    const QPair<QColor, QColor> directory{QColor("#B58A42"), QColor("#FFE08A")};
+    const QPair<QColor, QColor> script{QColor("#8F70B8"), QColor("#D9B8FF")};
+    const QPair<QColor, QColor> executable{QColor("#B83D3D"), QColor("#FF7A7A")};
+    const QPair<QColor, QColor> archive{QColor("#B97848"), QColor("#FFB98A")};
+    const QPair<QColor, QColor> document{QColor("#438D9A"), QColor("#8FEBFF")};
+    const QPair<QColor, QColor> image{QColor("#B76580"), QColor("#FFA8C6")};
+    const QPair<QColor, QColor> config{QColor("#7A8FA6"), QColor("#9CC4F0")};
+    const QPair<QColor, QColor> backup{QColor("#8A8F98"), QColor("#C3C9D4")};
+    const QPair<QColor, QColor> audio{QColor("#5FA37A"), QColor("#7DEFA6")};
+    const QPair<QColor, QColor> video{QColor("#B0568F"), QColor("#FF7AC8")};
+    const QPair<QColor, QColor> code{QColor("#6FA0C8"), QColor("#7CCBFF")};
+    const QPair<QColor, QColor> text{QColor("#B8A98A"), QColor("#F2E3BC")};
+    const QPair<QColor, QColor> binaryData{QColor("#8F8FD0"), QColor("#B4B4FF")};
+
+    if (values.value("isDir").toBool()) {
+        return directory;
+    }
+
+    // Extension overrides take precedence over MIME classification.
+    static const QHash<QString, QPair<QColor, QColor>> extensionOverrides = {
+        {QStringLiteral("py"), script},
+        {QStringLiteral("sh"), script},
+        {QStringLiteral("md"), document},
+        {QStringLiteral("bak"), backup},
+        {QStringLiteral("orig"), backup},
+        {QStringLiteral("old"), backup},
+        {QStringLiteral("tmp"), backup},
+        {QStringLiteral("swp"), backup},
+        {QStringLiteral("rej"), backup},
+        {QStringLiteral("conf"), config},
+        {QStringLiteral("cfg"), config},
+        {QStringLiteral("ini"), config},
+        {QStringLiteral("toml"), config},
+        {QStringLiteral("yaml"), config},
+        {QStringLiteral("yml"), config},
+        {QStringLiteral("json"), config},
+        {QStringLiteral("xml"), config},
+        {QStringLiteral("desktop"), config},
+        {QStringLiteral("service"), config},
+        {QStringLiteral("c"), code},
+        {QStringLiteral("h"), code},
+        {QStringLiteral("cpp"), code},
+        {QStringLiteral("rs"), code},
+        {QStringLiteral("go"), code},
+        {QStringLiteral("js"), code},
+        {QStringLiteral("ts"), code},
+        {QStringLiteral("java"), code},
+        {QStringLiteral("kt"), code},
+        {QStringLiteral("css"), code},
+        {QStringLiteral("html"), code},
+        {QStringLiteral("php"), code},
+        {QStringLiteral("txt"), text},
+        {QStringLiteral("log"), text},
+        {QStringLiteral("csv"), text},
+        {QStringLiteral("tsv"), text},
+        {QStringLiteral("iso"), archive},
+        {QStringLiteral("img"), archive},
+        {QStringLiteral("deb"), archive},
+        {QStringLiteral("rpm"), archive},
+        {QStringLiteral("apk"), archive},
+        {QStringLiteral("jar"), archive},
+    };
+
+    const QString suffix = QFileInfo(values.value("text").toString()).suffix().toLower();
+    const auto override = extensionOverrides.constFind(suffix);
+    if (override != extensionOverrides.constEnd()) {
+        return override.value();
+    }
+
+    const QString mimeName = values.value("mimeType").toString();
+    if (mimeName.isEmpty()) {
+        return {};
+    }
+
+    const QMimeType mime = QMimeDatabase().mimeTypeForName(mimeName);
+    if (!mime.isValid()) {
+        return {};
+    }
+
+    const auto inheritsAny = [&mime](std::initializer_list<const char *> names) {
+        for (const char *name : names) {
+            if (mime.inherits(QLatin1String(name))) {
+                return true;
+            }
+        }
+        return false;
+    };
+
+    if (mimeName.startsWith(QLatin1String("image/"))) {
+        return image;
+    }
+    if (mimeName.startsWith(QLatin1String("audio/"))) {
+        return audio;
+    }
+    if (mimeName.startsWith(QLatin1String("video/"))) {
+        return video;
+    }
+    if (inheritsAny({"application/x-executable", "application/x-pie-executable", "application/vnd.appimage"})) {
+        return executable;
+    }
+    if (inheritsAny({"text/x-script", "application/x-shellscript", "text/x-python", "application/x-perl", "application/x-ruby"})) {
+        return script;
+    }
+    if (inheritsAny({"application/zip", "application/x-tar", "application/gzip", "application/zstd", "application/x-xz",
+                     "application/x-bzip2", "application/x-7z-compressed", "application/vnd.rar"})) {
+        return archive;
+    }
+    if (inheritsAny({"application/pdf", "application/msword", "application/epub+zip", "text/markdown",
+                     "application/vnd.oasis.opendocument.text",
+                     "application/vnd.openxmlformats-officedocument.wordprocessingml.document"})) {
+        return document;
+    }
+    if (mimeName == QLatin1String("application/x-zerosize")
+        || mimeName == QLatin1String("inode/x-empty")
+        || mime.inherits(QLatin1String("text/plain"))) {
+        return text;
+    }
+    if (mimeName == QLatin1String("application/octet-stream")) {
+        return binaryData;
+    }
+
+    return {};
+}
